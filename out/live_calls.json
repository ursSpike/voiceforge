          "end_ms": 38000
        },
        {
          "turn_id": "t8",
          "speaker": "agent",
          "text": "Harshit ji, aapka phone number 12345987 711 hai kya?",
          "start_ms": 38531,
          "end_ms": 38643
        },
        {
          "turn_id": "t9",
          "speaker": "user",
          "text": "\u0939\u093e\u0902 \u091c\u0940 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948",
          "start_ms": 38643,
          "end_ms": 51147
        },
        {
          "turn_id": "t10",
          "speaker": "agent",
          "text": "Home sample collection ke liye kaunsa test chahiye?",
          "start_ms": 51685,
          "end_ms": 51808
        },
        {
          "turn_id": "t11",
          "speaker": "user",
          "text": "\u092e\u0941\u091d\u0947 blood test \u0914\u0930 urine test \u091a\u093e\u0939\u093f\u090f",
          "start_ms": 51808,
          "end_ms": 60991
        },
        {
          "turn_id": "t12",
          "speaker": "agent",
          "text": "Harshit ji, aapke home sample collection ke liye blood test aur urine test chahiye. Aapka preferred date kya hai?",
          "start_ms": 61659,
          "end_ms": 61792
        },
        {
          "turn_id": "t13",
          "speaker": "user",
          "text": "\u0939\u093e\u0902 \u091c\u0940 \u092e\u0947\u0930\u093e preferred date fifteenth \u091c\u0942\u0928 \u0939\u0948",
          "start_ms": 61792,
          "end_ms": 73543
        },
        {
          "turn_id": "t14",
          "speaker": "agent",
          "text": "Harshit ji, aapka preferred date 15 June hai. Aapko kis time slot mein sample collection chahiye?",
          "start_ms": 79553,
          "end_ms": 79672
        },
        {
          "turn_id": "t15",
          "speaker": "user",
          "text": "\u0936\u093e\u092e \u0915\u094b \u091b\u0939 \u092c\u091c\u0947 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948",
          "start_ms": 79672,
          "end_ms": 89545
        },
        {
          "turn_id": "t16",
          "speaker": "agent",
          "text": "Harshit ji, aapka preferred time 6 baje shaam hai. Kya main aapke liye home sample collection appointment confirm kar doon? Naam: Harshit, Phone: 12345987711, Service: Blood test aur urine test, Date: 15 June, Time: 6 PM.",
          "start_ms": 90924,
          "end_ms": 91053
        },
        {
          "turn_id": "t17",
          "speaker": "user",
          "text": "\u0920\u0940\u0915 \u0939\u0948 \u0915\u0930 \u0926\u0940\u091c\u093f\u090f",
          "start_ms": 91053,
          "end_ms": 110171
        },
        {
          "turn_id": "t18",
          "speaker": "agent",
          "text": "Harshit ji, main aapka home sample collection appointment confirm nahi kar sakti, lekin aapke details record kar liye hain. Hamara clinic staff aapki request verify karke aapse sampark karega. Dhanyavaad!",
          "start_ms": 111608,
          "end_ms": 111757
        },
        {
          "turn_id": "t19",
          "speaker": "user",
          "text": "\u0905\u091a\u094d\u091b\u093e \u0920\u0940\u0915 \u0939\u0948 \u091c\u0940 thank you",
          "start_ms": 111757,
          "end_ms": 124744
        },
        {
          "turn_id": "t20",
          "speaker": "agent",
          "text": "Aapka swagat hai, Harshit ji! Aapka din shubh ho. Namaste!",
          "start_ms": 125895,
          "end_ms": 126011
        }
