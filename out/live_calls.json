        {
          "turn_id": "t2",
          "speaker": "agent",
          "text": "Aapka naam kya hai?",
          "start_ms": 17457,
          "end_ms": 17583
        },
        {
          "turn_id": "t3",
          "speaker": "user",
          "text": "\u092e\u0947\u0930\u093e \u0928\u093e\u092e \u0939\u0930\u094d\u0937\u093f\u0924 \u0939\u0948",
          "start_ms": 17583,
          "end_ms": 22943
        },
        {
          "turn_id": "t4",
          "speaker": "agent",
          "text": "Harshit ji, aapka phone number kya hai?",
          "start_ms": 23428,
          "end_ms": 23558
        },
        {
          "turn_id": "t5",
          "speaker": "user",
          "text": "\u092e\u0947\u0930\u093e phone number one two three four five nine eight",
          "start_ms": 23558,
          "end_ms": 35351
        },
        {
          "turn_id": "t6",
          "speaker": "agent",
          "text": "Harshit ji, phone number confirm karna chahti hoon, kya yeh 1234598 hai? Agar poora number hai toh poora batayein.",
          "start_ms": 36171,
          "end_ms": 36310
        },
        {
          "turn_id": "t7",
