# Create a free key at https://aistudio.google.com/apikey then: cp .env.example .env
GEMINI_API_KEY=paste-key-here

# Bolna (SPEC §7.G ingest bonus): platform.bolna.ai -> Developers -> "Generate a new API Key"
# (shown ONLY once). Used as: Authorization: Bearer <key>. Keep it secret — it is a password.
BOLNA_API_KEY=paste-key-here

# Cartesia (SPEC §7.E: Sonic 3.5 hero-call re-voice, sponsor flagship). Format sk_car_...
# Used as: X-API-Key: <key> + Cartesia-Version header. api.cartesia.ai. Keep it secret.
CARTESIA_API_KEY=paste-key-here
